# Every variable here is OPTIONAL. With none of them set, the app runs fully offline:
# bundled ERCOT Parquet traces, recorded Jev answers, deterministic rules fallback.
# Copy to .env only if you want one of the live paths. Never commit real values.

# Optional: Jev, the decision layer. Set whichever one you have; the client picks it up.
# Vercel AI Gateway (POST https://ai-gateway.vercel.sh/v1/evaluate, model typesafe-ai/jev)
AI_GATEWAY_API_KEY=
# TypeSafe direct (POST https://api.typesafe.ai/v1/systemone, model jev-latest)
TYPESAFE_API_KEY=

# Optional: ERCOT Public API credentials, only if you use the official API instead of
# gridstatus. gridstatus reads the same public reports with no credentials.
ERCOT_API_USERNAME=
ERCOT_API_PASSWORD=
ERCOT_API_SUBSCRIPTION_KEY=

# Default load zone for the dashboard
DEFAULT_ZONE=LZ_HOUSTON
